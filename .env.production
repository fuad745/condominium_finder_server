# ================================================================
# Ready-to-upload production settings.
# After uploading the server/ folder, rename this file to .env
# (replacing the local one) and fill in the 6 marked values.
# The database schema installs itself on the first page load.
# ================================================================
APP_NAME="Addis Condo Finder"
APP_ENV=production
APP_KEY=base64:V9Oy9t4NkVm6dJrnNWj2LWFi2KwsZazHZFriPrz2rE0=
APP_DEBUG=false
APP_URL=https://your-domain.com            # <-- 1. your domain

DB_CONNECTION=mysql
DB_HOST=localhost
DB_DATABASE=your_db_name                   # <-- 2. cPanel MySQL database
DB_USERNAME=your_db_user                   # <-- 3. cPanel MySQL user
DB_PASSWORD=your_db_password               # <-- 4. cPanel MySQL password

# Created as the admin account on first boot (panel sign-in).
ADMIN_EMAIL=you@example.com                # <-- 5. your admin login
ADMIN_PASSWORD=change-me                   # <-- 6. your admin password

# Where the Flutter web build is served (leave empty if Android-only).
CONDO_WEB_APP_URL=

# Optional: "Sign in with Telegram" (free). Create a bot with
# @BotFather and paste its token here; empty hides the button.
TELEGRAM_BOT_TOKEN=

MAIL_MAILER=sendmail
MAIL_FROM_ADDRESS=no-reply@your-domain.com
MAIL_FROM_NAME="Addis Condo Finder"

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=single
LOG_LEVEL=warning
